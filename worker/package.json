{
  "name": "rhydive-mirror-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker mirror for the RhyDive chart API: R2-backed beatmap sync + transparent reverse proxy for every other endpoint.",
  "scripts": {
